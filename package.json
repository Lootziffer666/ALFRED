{
  "name": "alfret",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "alfret-daemon": "./dist/bin/alfret-daemon.js"
  },
  "exports": {
    ".": "./lib/index.ts",
    "./daemon": "./lib/daemon/index.ts",
    "./store": "./lib/store/index.ts",
    "./maid": "./lib/maid/index.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && bun build --target=node --outdir=dist ./bin/alfret-daemon.ts",
    "build:daemon": "bun build --target=node --outdir=dist ./bin/alfret-daemon.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "daemon": "bun ./bin/alfret-daemon.ts"
  },
  "dependencies": {
    "@material-symbols/font-400": "^0.45.10",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
